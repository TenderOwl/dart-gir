using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      title: _("Show shortcuts");
      action-name: "app.shortcuts";
    }

    Adw.ShortcutsItem {
      title: _("Filter to show all tasks");
      action-name: "win.filter('All')";
    }

    Adw.ShortcutsItem {
      title: _("Filter to show only open tasks");
      action-name: "win.filter('Open')";
    }

    Adw.ShortcutsItem {
      title: _("Filter to show only completed tasks");
      action-name: "win.filter('Done')";
    }
  }
}
