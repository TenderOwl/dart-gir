<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="SampleWindow" parent="GtkApplicationWindow">
    <property name="title">Sample</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkLabel" id="counterLabel">
            <property name="label">Not clicked</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="increment">
            <property name="label">Click me</property>
            <signal name="clicked" handler="on_increment_clicked"/>
          </object>
        </child>
        <child>
          <!-- A kebab-case signal that carries an argument. The
               bindings call it `onIconRelease` and hand it a
               `GtkEntryIconPosition` — the generated mixin has to use
               that exact name and forward the argument, or the part
               file does not compile. -->
          <object class="GtkEntry" id="entry">
            <signal name="icon-release" handler="on_icon_release"/>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
